<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CoopAFAMI</title>

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
            }

            /* ── NAVBAR ── */
            .navbar {
                background-color: #4a9e3f;
                display: flex;
                align-items: center;
                padding: 0 30px;
                height: 80px;
                position: sticky;
                top: 0;
                z-index: 100;
            }

            .navbar-logo {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-right: 40px;
                text-decoration: none;
            }

            .navbar-logo img.logo-circulo {
                height: 60px;
                width: 60px;
                object-fit: contain;
            }

            .navbar-logo img.logo-texto {
                height: 40px;
                object-fit: contain;
            }

            .navbar-menu {
                display: flex;
                list-style: none;
                gap: 5px;
            }

            .navbar-menu li a {
                display: block;
                padding: 10px 22px;
                color: white;
                text-decoration: none;
                font-weight: bold;
                font-size: 15px;
                border-radius: 4px;
                transition: background-color 0.25s, color 0.25s;
            }

            /* Estado activo: Inicio */
            .navbar-menu li a.activo {
                background-color: white;
                color: #4a9e3f;
            }

            /* Hover en los demás ítems */
            .navbar-menu li a:not(.activo):hover {
                background-color: white;
                color: #4a9e3f;
            }

            /* ── FOOTER ── */
            .footer {
                background-color: #4a9e3f;
                color: white;
                text-align: center;
                padding: 16px;
                font-size: 14px;
                margin-top: 40px;
            }
    </style>
</head>
<body>

    <!-- MENÚ SUPERIOR -->
    <nav class="navbar">
        <a class="navbar-logo" href="/">
            <img class="logo-circulo" src="~/media/logo-img-1.png" alt="Logo CoopAFAMI" />
            <img class="logo-texto" src="~/media/logo-img-2.png" alt="CoopAFAMI" />
        </a>
        <ul class="navbar-menu">
            <li><a href="/" class="activo">Inicio</a></li>
            <li><a href="#">Quiénes somos</a></li>
            <li><a href="#">Servicios</a></li>
            <li><a href="#">Actividades</a></li>
            <li><a href="#">Contacto</a></li>
        </ul>
    </nav>

    <!-- CONTENIDO DE CADA PÁGINA -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer">
        &copy; 2026 - CoopAFAMI Esto es un ejemplo hecho por Kalil
    </footer>

</body>
</html>