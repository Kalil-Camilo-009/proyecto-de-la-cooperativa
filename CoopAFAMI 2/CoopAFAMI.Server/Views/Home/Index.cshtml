@{
    ViewData["Title"] = "Inicio";
}

<section class="hero-section">
    <!-- El carrusel va de fondo. Se asume que carrusel-img-1 contiene el fondo azul con círculos y el gran logo circular a la derecha. -->
    <div class="hero-background" style="background-image: url('/media/carrusel-img-1.png');">
        <div class="hero-content">
            <div class="conoce-box slide-in-left">
                <h2>conoce quienes<br />somos</h2>
            </div>
            <a href="#" class="btn-entrar slide-in-left-delayed">Entrar</a>
        </div>
    </div>
</section>

<section class="services-section">
    <div class="services-title">
        <h3>Servicios</h3>
    </div>
    
    <div class="services-grid">
        <div class="service-item">
            <img src="~/media/cuentas-ahorro.png" alt="Cuentas de Ahorro" />
            <p>Cuentas de<br/>Ahorro</p>
        </div>
        <div class="service-item">
            <img src="~/media/prestamos-personales.png" alt="Préstamos Personales" />
            <p>Préstamos<br/>Personales</p>
        </div>
        <div class="service-item">
            <img src="~/media/prestamos-escolares.png" alt="Préstamos Escolares" />
            <p>Préstamos<br/>Escolares</p>
        </div>
        <div class="service-item">
            <img src="~/media/prestamos-hipotecario.png" alt="Préstamos Hipotecario" />
            <p>Préstamos<br/>Hipotecario</p>
        </div>
        <div class="service-item">
            <img src="~/media/prestamos-vehiculo.png" alt="Préstamos Vehículo" />
            <p>Préstamos<br/>Vehículo</p>
        </div>
        <div class="service-item">
            <img src="~/media/seguro-vehiculo.png" alt="Seguro de Vehículo" />
            <p>Seguro de Vehículo</p>
        </div>
    </div>

    <div class="services-action">
        <a href="#" class="btn-mas-servicios">Mas servicios</a>
    </div>
</section>
